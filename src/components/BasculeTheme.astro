---
/**
 * Bascule clair / sombre de l'en-tête.
 *
 * Le bouton est rendu masqué : sans JavaScript il ne pourrait rien changer, et
 * le thème suit alors la préférence système. Le script le révèle et lui donne
 * son état au chargement.
 *
 * L'état est porté par `aria-pressed` : « Mode sombre » enfoncé signifie que le
 * thème sombre est actif. L'intitulé ne change pas d'un état à l'autre, comme
 * l'attend ce motif de bouton à bascule.
 */
---

<button class="bascule" type="button" aria-pressed="false" hidden data-bascule-theme>
  <span class="bascule__piste" aria-hidden="true">
    <svg class="bascule__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.5"></circle>
      <path d="M12 1.5v2.5M12 20v2.5M3.9 3.9l1.8 1.8M18.3 18.3l1.8 1.8M1.5 12h2.5M20 12h2.5M3.9 20.1l1.8-1.8M18.3 5.7l1.8-1.8"></path>
    </svg>
    <svg class="bascule__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M20.5 14.8A8.8 8.8 0 0 1 9.2 3.5a8.8 8.8 0 1 0 11.3 11.3Z"></path>
    </svg>
    <span class="bascule__pastille"></span>
  </span>
  <span class="bascule__texte">Mode sombre</span>
</button>

<style>
  .bascule {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    /* Cible tactile d'au moins 24 px (WCAG 2.5.8). */
    min-block-size: 2rem;
    padding: 0.25rem 0.5rem;
    margin-inline-start: -0.5rem;
    border: 0;
    background: none;
    color: var(--encre-doux);
    font-family: var(--police-corps);
    font-size: 0.75rem;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .bascule:hover .bascule__texte {
    color: var(--encre);
  }

  .bascule__piste {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 2.75rem;
    block-size: 1.5rem;
    flex: none;
    padding-inline: 0.3125rem;
    border: 1px solid var(--regle);
    border-radius: 1rem;
    background: var(--papier-creux);
  }

  .bascule__icone {
    inline-size: 0.75rem;
    block-size: 0.75rem;
  }

  .bascule__pastille {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.1875rem;
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: 50%;
    background: var(--braise);
    translate: 0 -50%;
  }

  /* Le thème sombre est actif : la pastille passe à droite, sur la lune. */
  .bascule[aria-pressed='true'] .bascule__pastille {
    inset-inline-start: calc(100% - 1.1875rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bascule__pastille {
      transition: inset-inline-start 0.2s cubic-bezier(0.2, 0.7, 0.3, 1);
    }
  }
</style>

<script>
  import {
    COULEURS_THEME,
    REQUETE_SOMBRE,
    memoriserTheme,
    themeStocke,
    themeSysteme,
    type Theme,
  } from '../lib/theme';

  const bascule = document.querySelector<HTMLButtonElement>('[data-bascule-theme]');

  if (bascule) {
    const racine = document.documentElement;

    // Révélé seulement ici : sans JavaScript le bouton n'aurait servi à rien.
    bascule.hidden = false;

    const appliquer = (theme: Theme) => {
      racine.dataset.theme = theme;
      bascule.setAttribute('aria-pressed', String(theme === 'sombre'));

      // La balise unique posée par le script en ligne du <head>.
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      if (meta) meta.content = COULEURS_THEME[theme];
    };

    const themeActuel = racine.dataset.theme;
    appliquer(themeActuel === 'clair' || themeActuel === 'sombre' ? themeActuel : themeSysteme());

    bascule.addEventListener('click', () => {
      const suivant: Theme = racine.dataset.theme === 'sombre' ? 'clair' : 'sombre';
      memoriserTheme(suivant);
      appliquer(suivant);
    });

    // Tant que rien n'a été choisi, le site continue de suivre le système, y
    // compris si celui-ci bascule pendant la visite (thème automatique du soir).
    matchMedia(REQUETE_SOMBRE).addEventListener('change', (evenement) => {
      if (!themeStocke()) appliquer(evenement.matches ? 'sombre' : 'clair');
    });
  }
</script>
