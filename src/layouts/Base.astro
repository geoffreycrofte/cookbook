---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/karla/index.css';
import '../styles/global.css';
import BasculeTheme from '../components/BasculeTheme.astro';
import { CLE_THEME, COULEURS_THEME } from '../lib/theme';

/**
 * Les fichiers de police ne sont découverts qu'après l'analyse du CSS, soit
 * un aller-retour de trop avant le premier texte dessiné. On les déclare donc
 * en préchargement, avec l'URL empreintée que Vite produit.
 * Seul le sous-ensemble latin est préchargé : c'est celui dont le français a
 * besoin, les autres restent chargés à la demande.
 */
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import karla from '@fontsource-variable/karla/files/karla-latin-wght-normal.woff2?url';

interface Props {
  titre: string;
  description: string;
  /** true sur la page d'accueil : le titre du site y est déjà le h1. */
  accueil?: boolean;
  /** Chemin absolu de l'image de partage, généré par la page appelante. */
  imagePartage?: string;
  /** Texte alternatif de cette image, exigé par les bonnes pratiques Open Graph. */
  imagePartageAlt?: string;
  /** true sur une page qui ne doit apparaître dans aucun moteur de recherche. */
  noIndex?: boolean;
}

const {
  titre,
  description,
  accueil = false,
  imagePartage,
  imagePartageAlt,
  noIndex = false,
} = Astro.props;
const titreComplet = accueil ? 'Recettes du Lux' : `${titre} — Recettes du Lux`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const annee = new Date().getFullYear();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={accueil ? 'website' : 'article'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:site_name" content="Recettes du Lux" />
    {
      imagePartage && (
        <>
          <meta property="og:image" content={new URL(imagePartage, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={imagePartageAlt ?? description} />
        </>
      )
    }
    <meta name="twitter:card" content={imagePartage ? 'summary_large_image' : 'summary'} />

    {/* Repli sans JavaScript : le script plus bas remplace ces deux balises. */}
    <meta name="theme-color" content={COULEURS_THEME.clair} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={COULEURS_THEME.sombre} media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={karla} as="font" type="font/woff2" crossorigin />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icones/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icones/icone-apple-180.png" />
    <meta name="apple-mobile-web-app-title" content="Recettes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <slot name="tete" />

    {/*
      Applique le thème avant le premier rendu : posé plus tard, l'attribut
      ferait clignoter la page en clair avant de passer au sombre. Le script est
      donc en ligne et bloquant, il tient en quelques lignes.
    */}
    <script is:inline define:vars={{ CLE_THEME, COULEURS_THEME }}>
      let choix = null;
      try {
        choix = localStorage.getItem(CLE_THEME);
      } catch {
        /* Stockage refusé : on suit la préférence système. */
      }

      const theme =
        choix === 'clair' || choix === 'sombre'
          ? choix
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'sombre'
            : 'clair';

      document.documentElement.dataset.theme = theme;

      // Une balise theme-color pilotée par le script remplace les deux
      // variantes média, qui ne pourraient pas suivre un choix explicite.
      for (const balise of document.querySelectorAll('meta[name="theme-color"]')) {
        balise.remove();
      }
      const balise = document.createElement('meta');
      balise.name = 'theme-color';
      balise.content = COULEURS_THEME[theme];
      document.head.append(balise);
    </script>
  </head>

  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>

    <div class="braise-haute" aria-hidden="true"></div>

    <header class="entete">
      <div class="cadre entete__interieur">
        <a class="marque" href="/">
          <span class="marque__nom">Recettes</span>
          <span class="marque__complement">du Lux</span>
        </a>
        <div class="entete__outils">
          <p class="entete__note">Testées dans notre cuisine</p>
          <BasculeTheme />
        </div>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre pied__interieur">
        <div>
          <p class="pied__signature">Recettes <em>du Lux</em></p>
          <p class="pied__mention">
            Nos recettes, nos ratages et nos réussites. {annee}.
          </p>
        </div>

        {/* Second système de navigation, présent sur toutes les pages (RAWeb 12.1). */}
        <nav class="pied__nav" aria-label="Pied de page">
          <h2 class="sr-uniquement">Navigation du pied de page</h2>
          <ul>
            <li><a href="/materiel/">Notre matériel de cuisine</a></li>
            <li><a href="/plan-du-site/">Plan du site</a></li>
            <li><a href="/conditions-d-utilisation/">Conditions d’utilisation</a></li>
            <li>
              {/*
                Le nom accessible du lien vient du texte masqué : une icône
                seule n'en donne aucun. Le SVG est décoratif et retiré de
                l'arbre d'accessibilité (RAWeb 1.2).
              */}
              <a class="pied__flux" href="/rss.xml">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 12a7 7 0 0 1 7 7"></path>
                  <path d="M5 5a14 14 0 0 1 14 14"></path>
                  <circle cx="5.5" cy="18.5" r="1.6" fill="currentColor" stroke="none"></circle>
                </svg>
                <span class="sr-uniquement">Flux RSS</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      // Le service worker n'existe qu'en production : en développement il
      // servirait des pages périmées à chaque rechargement.
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((erreur) => {
            console.warn('Service worker non enregistré :', erreur);
          });
        });
      }
    </script>
  </body>
</html>

<style>
  .braise-haute {
    block-size: 4px;
    background: linear-gradient(
      90deg,
      var(--braise) 0%,
      color-mix(in oklab, var(--braise) 60%, #e8a33f) 55%,
      var(--braise) 100%
    );
  }

  .entete {
    border-block-end: 1px solid var(--regle);
  }

  .entete__interieur {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
  }

  .marque {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--encre);
    text-decoration: none;
  }

  .marque__nom {
    font-family: var(--police-titre);
    font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 32, 'wght' 600;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .marque__complement {
    font-family: var(--police-titre);
    font-style: italic;
    font-variation-settings: 'SOFT' 60, 'WONK' 1, 'opsz' 24, 'wght' 400;
    font-size: 1.25rem;
    color: var(--braise-texte);
  }

  .marque:hover .marque__complement {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .entete__outils {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  .entete__note {
    margin: 0;
    font-size: 0.75rem;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--encre-doux);
  }

  .pied {
    margin-block-start: 6rem;
    border-block-start: 1px solid var(--regle);
    background: var(--papier-creux);
  }

  .pied__interieur {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2.5rem;
  }

  .pied__signature {
    margin: 0;
    font-family: var(--police-titre);
    font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 28, 'wght' 500;
    font-size: 1.25rem;
  }

  .pied__signature em {
    color: var(--braise-texte);
  }

  .pied__mention {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    color: var(--encre-doux);
  }

  .pied__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Cible tactile d'au moins 24 px (WCAG 2.5.8). */
  .pied__nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.75rem;
    font-size: 0.9375rem;
  }

  /*
    Sélecteur en deux parties pour passer devant « .pied__nav a », plus
    spécifique qu'une classe seule.
  */
  .pied__nav .pied__flux {
    justify-content: center;
    inline-size: 2rem;
    min-block-size: 2rem;
  }

  .pied__nav .pied__flux svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }
</style>
